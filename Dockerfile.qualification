FROM ghcr.io/astral-sh/uv:0.12.9 AS uv
FROM python:3.14.7-slim
COPY --from=uv /uv /bin/uv
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PYTHONPATH=/app/src:/app UV_LINK_MODE=copy
WORKDIR /app
COPY source/pyproject.toml source/uv.lock ./
RUN uv sync --frozen --no-install-project
ENV PLAYWRIGHT_BROWSERS_PATH=/ms-playwright XDG_CONFIG_HOME=/tmp/chromium-config XDG_CACHE_HOME=/tmp/chromium-cache
RUN /app/.venv/bin/playwright install --with-deps --only-shell chromium && apt-get install -y --no-install-recommends poppler-utils && chmod -R a+rX /ms-playwright && rm -rf /var/lib/apt/lists/*
COPY source/ ./
RUN groupadd --gid 10001 qualification && useradd --uid 10001 --gid 10001 --no-create-home qualification
USER 10001:10001
CMD ["/app/.venv/bin/python", "manage.py", "check"]
