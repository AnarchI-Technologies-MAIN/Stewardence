# syntax=docker/dockerfile:1
FROM ghcr.io/astral-sh/uv:0.12.9 AS uv
FROM python:3.14.7-slim AS builder

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app \
    PLAYWRIGHT_BROWSERS_PATH=/ms-playwright \
    XDG_CONFIG_HOME=/tmp/chromium-config \
    XDG_CACHE_HOME=/tmp/chromium-cache \
    UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy

WORKDIR /app
COPY --from=uv /uv /bin/uv
COPY pyproject.toml uv.lock ./
RUN uv sync --frozen --only-group renderer --no-install-project \
    && uv run --no-sync playwright install --only-shell chromium \
    && rm -rf /tmp/* /var/lib/apt/lists/*

FROM python:3.14.7-slim AS runtime

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app \
    PLAYWRIGHT_BROWSERS_PATH=/ms-playwright \
    XDG_CONFIG_HOME=/tmp/chromium-config \
    XDG_CACHE_HOME=/tmp/chromium-cache

WORKDIR /app
COPY --from=builder /app/.venv /app/.venv
COPY --from=builder /ms-playwright /ms-playwright
RUN .venv/bin/playwright install-deps chromium \
    && chmod -R a+rX /ms-playwright \
    && rm -rf /tmp/* /var/lib/apt/lists/*

RUN groupadd --gid 10001 renderer \
    && useradd --uid 10001 --gid renderer --home-dir /app --no-create-home renderer

COPY renderer ./renderer
COPY static/brand/stewardence-helix-orbit-light.png ./static/brand/stewardence-helix-orbit-light.png

RUN install -d -o renderer -g renderer -m 0700 /work/output
USER renderer

EXPOSE 8080

CMD [".venv/bin/python", "-m", "renderer.server"]
