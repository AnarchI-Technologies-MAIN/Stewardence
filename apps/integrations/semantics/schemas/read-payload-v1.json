{
  "type": "object",
  "properties": {
    "schema_id": {
      "const": "urn:stewardence:evidence:read:v1"
    },
    "schema_digest": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^[0-9a-f]{64}$"
    },
    "semantic_profile_id": {
      "const": "stewardence.entity-descriptor.v1"
    },
    "semantic_profile_digest": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^[0-9a-f]{64}$"
    },
    "organization_id": {
      "type": "string",
      "maxLength": 36,
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "source": {
      "type": "object",
      "properties": {
        "provider": {
          "enum": [
            "quickbooks_online",
            "microsoft_365"
          ]
        },
        "environment": {
          "enum": [
            "sandbox",
            "owner_preview"
          ]
        },
        "api_version": {
          "type": "string",
          "maxLength": 40,
          "minLength": 1
        },
        "account_id": {
          "type": "string",
          "maxLength": 128,
          "minLength": 1
        },
        "artifact_receipt_id": {
          "type": "string",
          "maxLength": 36,
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "raw_bytes_sha256": {
          "type": "string",
          "maxLength": 64,
          "pattern": "^[0-9a-f]{64}$"
        },
        "captured_at": {
          "type": "string",
          "maxLength": 27,
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{6}Z$"
        },
        "media_type": {
          "const": "application/json"
        }
      },
      "required": [
        "provider",
        "environment",
        "api_version",
        "account_id",
        "artifact_receipt_id",
        "raw_bytes_sha256",
        "captured_at",
        "media_type"
      ],
      "additionalProperties": false
    },
    "adapter": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 80,
          "pattern": "^[a-z][a-z0-9_.-]{0,79}$"
        },
        "version": {
          "type": "string",
          "maxLength": 30,
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "artifact_digest": {
          "type": "string",
          "maxLength": 64,
          "pattern": "^[0-9a-f]{64}$"
        },
        "mapping_digest": {
          "type": "string",
          "maxLength": 64,
          "pattern": "^[0-9a-f]{64}$"
        },
        "configuration_digest": {
          "type": "string",
          "maxLength": 64,
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "id",
        "version",
        "artifact_digest",
        "mapping_digest",
        "configuration_digest"
      ],
      "additionalProperties": false
    },
    "subject": {
      "type": "object",
      "properties": {
        "namespace": {
          "type": "string",
          "maxLength": 80,
          "pattern": "^[a-z][a-z0-9_.-]{0,79}$"
        },
        "entity_id": {
          "type": "string",
          "maxLength": 128,
          "minLength": 1
        },
        "kind": {
          "enum": [
            "accounting_company",
            "directory_tenant"
          ]
        }
      },
      "required": [
        "namespace",
        "entity_id",
        "kind"
      ],
      "additionalProperties": false
    },
    "assertions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "$ref": "urn:stewardence:evidence:assertion:v1"
      }
    },
    "coverage": {
      "type": "object",
      "properties": {
        "state": {
          "enum": [
            "partial",
            "unknown"
          ]
        },
        "requested": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "maxLength": 80,
            "pattern": "^[a-z][a-z0-9_.-]{0,79}$"
          }
        },
        "covered": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "maxLength": 80,
            "pattern": "^[a-z][a-z0-9_.-]{0,79}$"
          }
        },
        "gaps": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "maxLength": 80,
            "pattern": "^[a-z][a-z0-9_.-]{0,79}$"
          }
        }
      },
      "required": [
        "state",
        "requested",
        "covered",
        "gaps"
      ],
      "additionalProperties": false
    },
    "supersedes": {
      "anyOf": [
        {
          "type": "string",
          "maxLength": 64,
          "pattern": "^[0-9a-f]{64}$"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "schema_id",
    "schema_digest",
    "semantic_profile_id",
    "semantic_profile_digest",
    "organization_id",
    "source",
    "adapter",
    "subject",
    "assertions",
    "coverage",
    "supersedes"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:stewardence:evidence:read:v1"
}
